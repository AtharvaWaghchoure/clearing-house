{
  "name": "@clearing-house/verifier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent compliance verifier for CLEARING HOUSE — reconstructs each settlement's compliance from public chain data and catches the venue misreporting. Shares no code with the venue.",
  "bin": {
    "ch-verify": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "audit": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "demo": "tsx src/demo/e2e.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
