# Copy to .env (gitignored) and fill. See docs/hedera-setup.md.
# Keep every value on its own line with NO trailing inline comments — some .env
# parsers fold "VALUE   # note" into the value. Put notes on their own # lines.

# --- Hedera testnet (ECDSA operator) ---
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=0x
HEDERA_RPC=https://testnet.hashio.io/api

# Reused ATS deployment on Hedera testnet -- do NOT redeploy the BLR (~180M gas).
ATS_BLR=0.0.9212226
ATS_BLR_EVM=0xba2d5fc2083a0b8f164c50e65d782087fba18e0a
ATS_FACTORY=0.0.9213391
ATS_FACTORY_EVM=0xd1f118a40f3b02883d35909ef2517e7edd78379d

# Chainlink HBAR/USD proxy on Hedera testnet (proxy, never the aggregator).
HBAR_USD_FEED=0x59bC155EB6c6C415fE43255aF66EcF0523c92B4a

# --- Arc testnet (payment leg). ARC_USDC is 6 decimals and the native gas token. ---
ARC_TESTNET_RPC=
ARC_USDC=0x3600000000000000000000000000000000000000
ARC_MEMO=0x5294E9927c3306DcBaDb03fe70b92e01cCede505
ARC_MULTICALL3FROM=0x522fAf9A91c41c443c66765030741e4AaCe147D0

# --- The Graph (fill after deploying the subgraph) ---
SUBGRAPH_URL=

# --- x402 NAV endpoint (settle through Blocky402, NOT x402.org/facilitator) ---
BLOCKY402_URL=https://api.testnet.blocky402.com
